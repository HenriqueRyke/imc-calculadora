# ============================================================
# Variáveis de ambiente — modelo versionável (sem valores reais)
# Copie para `.env.local` e preencha com os seus valores.
# `.env.local` nunca vai para o Git.
# ============================================================

# Supabase — URL do projeto e chave pública (anon/publishable)
# A anon key é pública por definição e vai para o navegador.
# Encontre em: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas servidor — NUNCA no navegador nem no Git
# Cuidado: esta chave ignora as regras de segurança (RLS).
# Só use no servidor e com responsabilidade.
SUPABASE_SERVICE_ROLE_KEY=